---
interface Props {
  title: string;
  description: string;
  href: string;
  icon: string;
}

const { title, description, href, icon } = Astro.props;
---

<a 
  href={href} 
  class="block bg-white rounded-xl p-6 border border-gray-200 shadow-sm hover:shadow-md hover:border-emerald-700 transition-all duration-200 hover:-translate-y-1"
>
  <div class="text-4xl mb-4">{icon}</div>
  <h3 class="text-xl font-bold text-emerald-900 mb-2">{title}</h3>
  <p class="text-gray-600 text-sm leading-relaxed">{description}</p>
</a>