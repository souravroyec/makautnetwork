
---
const tools = [
  {
    number: "01",
    name: "Makaut SGPA to CGPA Calculator",
    description:
      "Enter your SGPA for each semester to calculate your overall CGPA. Whether you want to check your academic progress or know your current CGPA before applying for a job or higher studies, this calculator helps you get the result quickly.",
    href: "/sgpa-to-cgpa",
    action: "Calculate CGPA",
    icon: "chart",
  },
  {
    number: "02",
    name: "MAKAUT Percentage Calculator",
    description:
      "Have your CGPA but need to know your percentage? Enter your CGPA to calculate the equivalent percentage using the applicable MAKAUT conversion formula. Use it when filling out job applications, preparing your résumé, or checking eligibility requirements.",
    href: "/makaut-percentage-calculator",
    action: "Calculate percentage",
    icon: "percent",
  },
];
---

<section
  aria-labelledby="tools-heading"
  class="relative isolate overflow-hidden border-t border-slate-700/30 bg-[#071426] lg:px-5 py-3 text-slate-100 px-2 lg:py-24"
>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(circle_at_1px_1px,rgba(148,163,184,0.12)_1px,transparent_0)] bg-[size:27px_27px]"
  ></div>

  <div class="mx-auto max-w-6xl">
    <header class="mb-10">
      <div class="mb-5 flex items-center gap-2.5 text-xs font-bold tracking-[0.16em] text-emerald-400 uppercase">
        <span class="size-2 rounded-full bg-emerald-400 shadow-[0_0_12px_rgba(52,211,153,0.55)]"></span>
        All Your Grade Calculators in One Place
      </div>

      <div class="flex items-end justify-between gap-6">
        <div>
          <h2
            id="tools-heading"
            class="text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl"
          >
            MAKAUT Grade Calculator, <span class="text-emerald-400">Made Easy</span>
          </h2>

          <p class="mt-4 max-w-2xl text-sm leading-7 text-slate-400 sm:text-base">
           Need to convert SGPA, calculate CGPA, or work out your percentage? Choose a calculator below and get your result.
          </p>
        </div>

        
      </div>
    </header>

    <div class="grid gap-5 md:grid-cols-2">
      {tools.map((tool) => (
        <a
          href={tool.href}
          aria-label={`${tool.name} — ${tool.action}`}
          class="group relative flex min-h-64 flex-col overflow-hidden rounded-2xl border border-slate-700/60 bg-gradient-to-br from-[#10223a] to-[#09192c] p-2 transition duration-200 hover:-translate-y-1 hover:border-emerald-400/40 hover:shadow-[0_16px_45px_rgba(0,0,0,0.18)] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-emerald-400 sm:p-7"
        >
          <div
            aria-hidden="true"
            class="pointer-events-none absolute -bottom-16 -right-12 size-40 rounded-full border border-emerald-300/[0.09] shadow-[0_0_0_24px_rgba(110,231,183,0.025),0_0_0_48px_rgba(110,231,183,0.018)]"
          ></div>

          <div class="relative flex items-center justify-between">
            <span class="text-xs font-semibold tracking-widest text-slate-500">
              {tool.number}
            </span>

            <span class="grid size-12 place-items-center rounded-xl border border-emerald-400/20 bg-emerald-400/[0.08] text-emerald-400 transition group-hover:bg-emerald-400/15">
              {tool.icon === "chart" ? (
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  class="size-6"
                  aria-hidden="true"
                >
                  <path
                    d="M3 3v18h18M8 15l4-4 4 4 5-7"
                    stroke="currentColor"
                    stroke-width="1.7"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              ) : (
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  class="size-6"
                  aria-hidden="true"
                >
                  <path
                    d="M19 5 5 19"
                    stroke="currentColor"
                    stroke-width="1.7"
                    stroke-linecap="round"
                  />
                  <circle cx="7" cy="7" r="2.2" stroke="currentColor" stroke-width="1.7" />
                  <circle cx="17" cy="17" r="2.2" stroke="currentColor" stroke-width="1.7" />
                </svg>
              )}
            </span>
          </div>

          <div class="relative flex-1 py-2">
            <h3 class="text-xl font-semibold tracking-tight text-white sm:text-2xl">
              {tool.name}
            </h3>
            <p class="mt-3 max-w-md text-sm leading-7 text-slate-400">
              {tool.description}
            </p>
          </div>

          <div class="relative flex items-center justify-between border-t border-slate-700/50 pt-4 text-sm font-semibold text-emerald-400">
            <span>{tool.action}</span>
            <span class="text-lg transition-transform duration-200 group-hover:-translate-y-0.5 group-hover:translate-x-0.5">
              ↗
            </span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
