
---
const programs = [
  {
    number: "01",
    category: "ENVIRONMENT",
    name: "Tree Plantation Certificate",
    description:
      "Participate in the tree plantation programme, receive a certificate of participation, and use it for MAKAUT MAR points.",
    href: "https://greenificate.makaut.net",
    action: "Explore Greenificate",
    icon: "leaf",
  },
  {
    number: "02",
    category: "PHOTOGRAPHY",
    name: "Photography Club Certificate",
    description:
      "Participate in the online Photography Club, share your photographs, and receive a certificate that can be used for MAKAUT MAR points.",
    href: "https://photexity.makaut.net",
    action: "Explore Photexity",
    icon: "camera",
  },
  {
    number: "03",
    category: "TECHNOLOGY",
    name: "Tech Quiz Certificate",
    description:
      "Test your technical knowledge by answering quiz questions and receive a certificate that you can use for MAKAUT MAR points.",
    href: "/tech-quiz",
    action: "Take the quiz",
    icon: "quiz",
  },
];
---

<section
  aria-labelledby="certificates-heading"
  class="relative isolate overflow-hidden border-t border-slate-700/30 bg-[#071426] lg:px-5 py-3 text-slate-100 px-2 lg:py-24"
>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 -z-10 bg-[linear-gradient(rgba(148,163,184,0.035)_1px,transparent_1px),linear-gradient(90deg,rgba(148,163,184,0.035)_1px,transparent_1px)] bg-[size:42px_42px]"
  ></div>

  <div
    aria-hidden="true"
    class="pointer-events-none absolute -right-32 -top-40 -z-10 size-96 rounded-full bg-emerald-400/[0.06] blur-3xl"
  ></div>

  <div class="mx-auto max-w-6xl">
    <header class="mb-10">
      <div class="mb-5 flex items-center gap-2.5 text-xs font-bold tracking-[0.16em] text-emerald-400 uppercase">
        <span class="size-2 rounded-full bg-emerald-400 shadow-[0_0_12px_rgba(52,211,153,0.55)]"></span>
        Earn Certificates by Participating in Various Activities
      </div>

      <div class="flex items-start justify-between gap-5">
        <div>
          <h2
            id="certificates-heading"
            class="text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl"
          >
            MAR Points
            <span class="text-emerald-400">Certification</span>
          </h2>

          <p class="mt-4 max-w-2xl text-sm leading-7 text-slate-400 sm:text-base">
           Take part in various activities beyond your regular studies and earn certificates that can be used to claim MAKAUT MAR points.
          </p>
        </div>

        <span class="hidden size-14 shrink-0 place-items-center rounded-2xl border border-emerald-400/20 bg-emerald-400/[0.06] text-emerald-400 sm:grid">
          <svg viewBox="0 0 24 24" fill="none" class="size-7" aria-hidden="true">
            <path
              d="m12 3 2.5 2 3.2.2.9 3.1 2 2.5-2 2.5-.9 3.1-3.2.2-2.5 2-2.5-2-3.2-.2-.9-3.1-2-2.5 2-2.5.9-3.1 3.2-.2L12 3Z"
              stroke="currentColor"
              stroke-width="1.4"
              stroke-linejoin="round"
            />
            <path
              d="m9 11.5 2 2 4-4"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </span>
      </div>
    </header>

    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {programs.map((program) => (
        <article
          class="group relative flex min-h-[330px] flex-col overflow-hidden rounded-2xl border border-slate-700/60 bg-gradient-to-br from-[#10223a] to-[#09192c] p-6 transition duration-200 hover:-translate-y-1 hover:border-emerald-400/40 hover:shadow-[0_16px_45px_rgba(0,0,0,0.18)] sm:p-7"
        >
          <div
            aria-hidden="true"
            class="absolute left-6 right-6 top-0 h-0.5 bg-gradient-to-r from-emerald-400/70 to-transparent opacity-60"
          ></div>

          <div class="flex items-center justify-between gap-3">
            <span class="text-xs font-semibold tracking-widest text-slate-500">
              {program.number}
            </span>
            <span class="rounded-md border border-slate-600/40 bg-slate-400/[0.05] px-2 py-1.5 text-[9px] font-bold tracking-widest text-slate-400">
              {program.category}
            </span>
          </div>

          <div class="my-7 grid size-12 place-items-center rounded-xl border border-emerald-400/20 bg-emerald-400/[0.08] text-emerald-400 transition group-hover:bg-emerald-400/15">
            {program.icon === "leaf" && (
              <svg viewBox="0 0 24 24" fill="none" class="size-6" aria-hidden="true">
                <path
                  d="M20 4c-7 0-13 3-13 10a5 5 0 0 0 5 5c7 0 10-6 8-15Z"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linejoin="round"
                />
                <path d="M4 21c3-6 7-9 12-12" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
              </svg>
            )}

            {program.icon === "camera" && (
              <svg viewBox="0 0 24 24" fill="none" class="size-6" aria-hidden="true">
                <path
                  d="M14 5h-4L8.5 7H5a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3.5L14 5Z"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linejoin="round"
                />
                <circle cx="12" cy="13" r="3.2" stroke="currentColor" stroke-width="1.6" />
              </svg>
            )}

            {program.icon === "quiz" && (
              <svg viewBox="0 0 24 24" fill="none" class="size-6" aria-hidden="true">
                <path
                  d="M12 3 20 6v5c0 5-3.5 8-8 10-4.5-2-8-5-8-10V6l8-3Z"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linejoin="round"
                />
                <path
                  d="m9 12 2 2 4-4"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            )}
          </div>

          <h3 class="text-xl font-semibold tracking-tight text-white">
            {program.name}
          </h3>

          <p class="mt-3 flex-1 text-sm leading-7 text-slate-400">
            {program.description}
          </p>

          <a
            href={program.href}
            target={program.href.startsWith("http") ? "_blank" : undefined}
            rel={program.href.startsWith("http") ? "noopener noreferrer" : undefined}
            class="mt-6 flex items-center justify-between gap-3 border-t border-slate-700/50 pt-4 text-sm font-semibold text-emerald-400 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-emerald-400"
          >
            <span>{program.action}</span>
            <span class="text-lg transition-transform duration-200 group-hover:-translate-y-0.5 group-hover:translate-x-0.5">
              ↗
            </span>
          </a>
        </article>
      ))}
    </div>

    <footer class="mt-8 flex items-center justify-center gap-3 text-center">
      <svg
        viewBox="0 0 24 24"
        fill="none"
        class="size-5 shrink-0 text-emerald-400"
        aria-hidden="true"
      >
        <path
          d="M12 3 20 6v5c0 5-3.5 8-8 10-4.5-2-8-5-8-10V6l8-3Z"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linejoin="round"
        />
        <path d="m9 12 2 2 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
      </svg>
      <p class="text-xs leading-6 text-slate-500">
        Select a program to learn more about its activities and certificate process.
      </p>
    </footer>
  </div>
</section>
